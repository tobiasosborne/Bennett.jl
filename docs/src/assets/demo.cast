[0.4, "o", "\u001b[1m\u001b[32mjulia>\u001b[0m "]
[1.2, "o", "using Bennett\r\n"]
[2.2, "o", "\r\n\u001b[1m\u001b[32mjulia>\u001b[0m "]
[3.0, "o", "f(x::Int8) = x*x + Int8(3)*x + Int8(1)\r\n"]
[3.4, "o", "f (generic function with 1 method)\r\n"]
[4.4, "o", "\r\n\u001b[1m\u001b[32mjulia>\u001b[0m "]
[5.2, "o", "c = reversible_compile(f, Int8)      \u001b[90m# LLVM IR → gates → Bennett-ize\u001b[0m\r\n"]
[6.1, "o", "ReversibleCircuit:\r\n  Wires:     265\r\n  Input:     8 wires [8]\r\n  Output:    8 wires\r\n  Ancillae:  249\r\n  Gates:     482 (NOT=14, CNOT=300, Toffoli=168)\r\n  Depth:     89\r\n  Peak live: 8\r\n"]
[8.4, "o", "\r\n\u001b[1m\u001b[32mjulia>\u001b[0m "]
[9.2, "o", "simulate(c, Int8(5))                 \u001b[90m# = 25 + 15 + 1\u001b[0m\r\n"]
[9.8, "o", "41\r\n"]
[11.2, "o", "\r\n\u001b[1m\u001b[32mjulia>\u001b[0m "]
[12.0, "o", "verify_reversibility(c)              \u001b[90m# every ancilla back to 0, input preserved\u001b[0m\r\n"]
[12.7, "o", "true\r\n"]
[14.4, "o", "\r\n\u001b[1m\u001b[32mjulia>\u001b[0m "]
[15.2, "o", "toffoli_depth(c)\r\n"]
[15.8, "o", "36\r\n"]
[17.0, "o", "\r\n\u001b[1m\u001b[32mjulia>\u001b[0m "]
[17.8, "o", "cc = controlled(c);                  \u001b[90m# lift to a quantum-controlled operation\u001b[0m\r\n"]
[18.8, "o", "\r\n\u001b[1m\u001b[32mjulia>\u001b[0m "]
[19.6, "o", "simulate(cc, true, Int8(5))          \u001b[90m# control on  → compute f\u001b[0m\r\n"]
[20.2, "o", "41\r\n"]
[21.6, "o", "\r\n\u001b[1m\u001b[32mjulia>\u001b[0m "]
[22.4, "o", "simulate(cc, false, Int8(5))         \u001b[90m# control off → output register stays 0\u001b[0m\r\n"]
[23.0, "o", "0\r\n"]
[24.4, "o", "\r\n\u001b[1m\u001b[32mjulia>\u001b[0m "]
[29.5, "o", ""]
